export const SimpleCodeSystemValues = ["code1", "code2"] as const;

export type SimpleCodeSystem = typeof SimpleCodeSystemValues[number];

/**
 * Type guard for SimpleCodeSystem
 */
export function isSimpleCodeSystem(value: string): value is SimpleCodeSystem {
  return (SimpleCodeSystemValues as readonly string[]).includes(value);
}
