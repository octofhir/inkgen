expression: "file(&output, \"patient.ts\")"
---

import * as v from 'valibot';
import type { FhirString } from "./primitives";

export interface PatientContact {
  name?: FhirString;
}

/**
 * Valibot schema for PatientContact
 */
export const PatientContactSchema = v.object({
  name: v.optional(v.string()),
});

/**
 * Type inferred from Valibot schema
 */
export type PatientContactValidated = v.InferOutput<typeof PatientContactSchema>;


export interface Patient {
  /** Resource type identifier */
  resourceType: "Patient";
  contact?: PatientContact;
  link?: Array<Patient>;
  priorContact?: PatientContact;
}
/**
 * Type guard to check if input is a valid Patient
 */
export function isPatient(input: unknown): input is Patient {
  if (typeof input !== "object" || input === null) {
    return false;
  }
  const obj = input as Record<string, unknown>;
  if (obj.resourceType !== undefined && obj.resourceType !== "Patient") {
    return false;
  }

  return true;
}

/**
 * Valibot schema for Patient
 */
export const PatientSchema: v.GenericSchema<Record<string, unknown>> = v.object({
  resourceType: v.literal("Patient"),
  contact: v.optional(PatientContactSchema),
  link: v.optional(v.array(v.lazy(() => PatientSchema))),
  priorContact: v.optional(v.lazy(() => PatientContactSchema)),
});

/**
 * Type inferred from Valibot schema
 */
export type PatientValidated = v.InferOutput<typeof PatientSchema>;

/**
 * Safely parse and validate input as Patient using Valibot schema
 * @param input - The input to parse
 * @returns The parsed Patient if valid, or false if invalid
 */
export function parsePatient(input: unknown): PatientValidated | false {
  const result = v.safeParse(PatientSchema, input);
  return result.success ? result.output : false;
}
