{%- if structure.generate_zod_schema %}
{{ structure.validation_import }}

{%- endif %}
{%- if structure.has_primitives %}
import type { {{ structure.primitive_imports | join(sep=", ") }} } from "./primitives";
{% endif -%}
{%- if structure.imports | length > 0 %}
{% for import in structure.imports -%}
{%- if import.is_type_only %}
import type { {{ import.types | join(sep=", ") }} } from "{{ import.path }}";
{%- else %}
import { {{ import.types | join(sep=", ") }} } from "{{ import.path }}";
{%- endif %}
{% endfor -%}

{%- endif %}
{%- if structure.generate_zod_schema and structure.schema_imports | length > 0 %}
{% for import in structure.schema_imports -%}
import { {% for type in import.types %}{{ type }}Schema{% if not loop.last %}, {% endif %}{% endfor %} } from "{{ import.path }}";
{% endfor -%}

{%- endif %}
{%- if structure.nested_types | length > 0 %}
{%- for nested in structure.nested_types %}
{%- if nested.description %}
/**
 * {{ nested.description }}
 */
{%- endif %}
export interface {{ nested.type_name }} {
{%- for field in nested.fields %}
{%- if field.doc %}
  /** {{ field.doc }} */
{%- endif %}
  {{ field.name }}{% if field.optional %}?{% endif %}: {{ field.type_expr }};
{%- endfor %}
}

{%- if structure.generate_zod_schema %}

/**
 * {{ structure.validation_name }} schema for {{ nested.type_name }}
 */
export const {{ nested.type_name }}Schema{% if nested.is_recursive %}{{ structure.recursive_annotation }}{% endif %} = {{ structure.schema_object }}({
{%- for field in nested.fields %}
{%- if field.zod_type %}
  {{ field.name }}: {{ field.zod_type }},
{%- endif %}
{%- endfor %}
});

/**
 * Type inferred from {{ structure.validation_name }} schema
 */
export type {{ nested.type_name }}Validated = {{ structure.infer_type }}<typeof {{ nested.type_name }}Schema>;
{%- endif %}

{% endfor -%}
{%- endif %}
{%- if structure.emit_interface %}
export interface {{ structure.type_name }}{% if structure.type_parameters %}<{{ structure.type_parameters }}>{% endif %} {
{%- for field in structure.fields %}
{%- if field.doc %}
  /** {{ field.doc }} */
{%- endif %}
  {{ field.name }}{% if field.optional %}?{% endif %}: {{ field.type_expr }};
{%- endfor %}
}
{%- endif %}

{%- if structure.emit_class %}
export class {{ structure.class_name }}{% if structure.type_parameters %}<{{ structure.type_parameters }}>{% endif %} {
{%- for field in structure.fields %}
  declare {{ field.name }}{% if field.optional %}?{% endif %}: {{ field.type_expr }};
{%- endfor %}

  constructor(init: Partial<{{ structure.type_name }}{% if structure.type_arguments %}<{{ structure.type_arguments }}>{% endif %}> = {}) {
    Object.assign(this, init);
  }

  static create{% if structure.type_parameters %}<{{ structure.type_parameters }}>{% endif %}(init: Partial<{{ structure.type_name }}{% if structure.type_arguments %}<{{ structure.type_arguments }}>{% endif %}> = {}): {{ structure.class_name }}{% if structure.type_arguments %}<{{ structure.type_arguments }}>{% endif %} {
    return new {{ structure.class_name }}{% if structure.type_arguments %}<{{ structure.type_arguments }}>{% endif %}(init);
  }
}
{%- endif %}

{%- if structure.structural_guards %}
/**
 * Type guard to check if input is a valid {{ structure.type_name }}
 */
export function is{{ structure.type_name }}(input: unknown): input is {{ structure.type_name }} {
  if (typeof input !== "object" || input === null) {
    return false;
  }

{%- if structure.resource_type_guard %}
  const obj = input as Record<string, unknown>;
  if (obj.resourceType !== undefined && obj.resourceType !== "{{ structure.type_name }}") {
    return false;
  }
{%- endif %}

  return true;
}
{%- endif %}

{%- if structure.generate_zod_schema %}

/**
 * {{ structure.validation_name }} schema for {{ structure.type_name }}
 */
export const {{ structure.type_name }}Schema{% if structure.is_recursive_schema %}{{ structure.recursive_annotation }}{% endif %} = {{ structure.schema_object }}({
{%- for field in structure.zod_fields %}
  {{ field.name }}: {{ field.zod_type }},
{%- endfor %}
});

/**
 * Type inferred from {{ structure.validation_name }} schema
 */
export type {{ structure.type_name }}Validated = {{ structure.infer_type }}<typeof {{ structure.type_name }}Schema>;

/**
 * Safely parse and validate input as {{ structure.type_name }} using {{ structure.validation_name }} schema
 * @param input - The input to parse
 * @returns The parsed {{ structure.type_name }} if valid, or false if invalid
 */
export function parse{{ structure.type_name }}(input: unknown): {{ structure.type_name }}Validated | false {
{%- if structure.choice_groups is defined and structure.choice_groups | length > 0 %}
  // FHIR choice (`value[x]`) elements carry at most one typed member
  // (exactly one when the choice is required).
{%- if structure.validation_library == "zod" %}
  const result = {{ structure.type_name }}Schema.superRefine((val, ctx) => {
    const v = val as Record<string, unknown>;
{%- for group in structure.choice_groups %}
{%- if group.required %}
    if ([{% for m in group.members %}v.{{ m }}{% if not loop.last %}, {% endif %}{% endfor %}].filter((x) => x !== undefined).length !== 1) {
      ctx.addIssue({ code: "custom", message: "Exactly one of {{ group.members | join(sep=", ") }} must be present", path: [] });
    }
{%- else %}
    if ([{% for m in group.members %}v.{{ m }}{% if not loop.last %}, {% endif %}{% endfor %}].filter((x) => x !== undefined).length > 1) {
      ctx.addIssue({ code: "custom", message: "At most one of {{ group.members | join(sep=", ") }} may be present", path: [] });
    }
{%- endif %}
{%- endfor %}
  }).safeParse(input);
{%- else %}
  const schema = v.pipe({{ structure.type_name }}Schema, v.rawCheck(({ dataset, addIssue }) => {
    if (!dataset.typed) {
      return;
    }
    const obj = dataset.value as Record<string, unknown>;
{%- for group in structure.choice_groups %}
{%- if group.required %}
    if ([{% for m in group.members %}obj.{{ m }}{% if not loop.last %}, {% endif %}{% endfor %}].filter((x) => x !== undefined).length !== 1) {
      addIssue({ message: "Exactly one of {{ group.members | join(sep=", ") }} must be present" });
    }
{%- else %}
    if ([{% for m in group.members %}obj.{{ m }}{% if not loop.last %}, {% endif %}{% endfor %}].filter((x) => x !== undefined).length > 1) {
      addIssue({ message: "At most one of {{ group.members | join(sep=", ") }} may be present" });
    }
{%- endif %}
{%- endfor %}
  }));
  const result = v.safeParse(schema, input);
{%- endif %}
{%- else %}
{%- if structure.validation_library == "zod" %}
  const result = {{ structure.type_name }}Schema.safeParse(input);
{%- else %}
  const result = v.safeParse({{ structure.type_name }}Schema, input);
{%- endif %}
{%- endif %}
{%- if structure.validation_library == "zod" %}
  return result.success ? result.data : false;
{%- else %}
  return result.success ? result.output : false;
{%- endif %}
}
{%- endif %}

{%- if structure.slices is defined and structure.slices | length > 0 %}

// Discriminated unions for sliced elements
{%- for slice in structure.slices %}
{%- if slice.discriminator %}
{%- set discriminator_field = slice.discriminator.path | split(pat=".") | last -%}
{%- else %}
{%- set discriminator_field = "value" -%}
{%- endif %}

/**
 * Discriminated union for {{ slice.path }}
 */
export type {{ slice.path | split(pat=".") | last | title }}Slice =
{%- for slice_info in slice.slices %}
{%- if slice_info.discriminator_value %}
  | { {{ discriminator_field }}: "{{ slice_info.discriminator_value }}"{% if slice_info.discriminator_type %}, value: {{ slice_info.discriminator_type }}{% endif %} }
{%- endif %}
{%- endfor %};

// Type guards for slices
{%- for slice_info in slice.slices %}
{%- if slice_info.discriminator_value %}
export function is{{ slice_info.name | title }}Slice(
  value: {{ slice.path | split(pat=".") | last | title }}Slice
): value is Extract<{{ slice.path | split(pat=".") | last | title }}Slice, { {{ discriminator_field }}: "{{ slice_info.discriminator_value }}" }> {
  return value.{{ discriminator_field }} === "{{ slice_info.discriminator_value }}";
}
{%- endif %}
{% endfor %}
{%- endfor %}
{%- endif %}
