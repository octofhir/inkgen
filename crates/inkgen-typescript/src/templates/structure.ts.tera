{%- if structure.generate_zod_schema %}
import { z } from 'zod';

{%- endif %}
{%- if structure.has_primitives %}
import type { {{ structure.primitive_imports | join(sep=", ") }} } from "./primitives";
{% endif -%}
{%- if structure.imports | length > 0 %}
{% for import in structure.imports -%}
import type { {{ import.types | join(sep=", ") }} } from "{{ import.path }}";
{% endfor -%}

{%- endif %}
{%- if structure.generate_zod_schema and structure.schema_imports | length > 0 %}
{% for import in structure.schema_imports -%}
import { {% for type in import.types %}{{ type }}Schema{% if not loop.last %}, {% endif %}{% endfor %} } from "{{ import.path }}";
{% endfor -%}

{%- endif %}
{%- if structure.nested_types | length > 0 %}
{%- for nested in structure.nested_types %}
{%- if nested.description %}
/**
 * {{ nested.description }}
 */
{%- endif %}
export interface {{ nested.type_name }} {
{%- for field in nested.fields %}
{%- if field.doc %}
  /** {{ field.doc }} */
{%- endif %}
  {{ field.name }}{% if field.optional %}?{% endif %}: {{ field.type_expr }};
{%- endfor %}
}

{%- if structure.generate_zod_schema %}

/**
 * Zod schema for {{ nested.type_name }}
 */
export const {{ nested.type_name }}Schema = z.object({
{%- for field in nested.fields %}
{%- if field.zod_type %}
  {{ field.name }}: {{ field.zod_type }},
{%- endif %}
{%- endfor %}
});

/**
 * Type inferred from Zod schema
 */
export type {{ nested.type_name }}Validated = z.infer<typeof {{ nested.type_name }}Schema>;
{%- endif %}

{% endfor -%}
{%- endif %}
{%- if structure.emit_interface %}
export interface {{ structure.type_name }}{% if structure.type_parameters %}<{{ structure.type_parameters }}>{% endif %} {
{%- for field in structure.fields %}
{%- if field.doc %}
  /** {{ field.doc }} */
{%- endif %}
  {{ field.name }}{% if field.optional %}?{% endif %}: {{ field.type_expr }};
{%- endfor %}
}
{%- endif %}

{%- if structure.emit_class %}
export class {{ structure.class_name }} {
{%- for field in structure.fields %}
  {{ field.name }}{% if field.optional %}?{% endif %}: {{ field.type_expr }};
{%- endfor %}

  constructor(init: Partial<{{ structure.type_name }}> = {}) {
    Object.assign(this, init);
  }

  static create(init: Partial<{{ structure.type_name }}> = {}): {{ structure.class_name }} {
    return new {{ structure.class_name }}(init);
  }
}
{%- endif %}

{%- if structure.structural_guards %}
/**
 * Type guard to check if input is a valid {{ structure.type_name }}
 */
export function is{{ structure.type_name }}(input: unknown): input is {{ structure.type_name }} {
  if (typeof input !== "object" || input === null) {
    return false;
  }

  // Check resourceType for FHIR resources
  const obj = input as any;
  if (obj.resourceType !== undefined && obj.resourceType !== "{{ structure.type_name }}") {
    return false;
  }

  return true;
}
{%- endif %}

{%- if structure.generate_zod_schema %}

/**
 * Zod schema for {{ structure.type_name }}
 */
export const {{ structure.type_name }}Schema = z.object({
{%- for field in structure.zod_fields %}
  {{ field.name }}: {{ field.zod_type }},
{%- endfor %}
});

/**
 * Type inferred from Zod schema
 */
export type {{ structure.type_name }}Validated = z.infer<typeof {{ structure.type_name }}Schema>;

/**
 * Safely parse and validate input as {{ structure.type_name }} using Zod schema
 * @param input - The input to parse
 * @returns The parsed {{ structure.type_name }} if valid, or false if invalid
 */
export function parse{{ structure.type_name }}(input: unknown): {{ structure.type_name }}Validated | false {
  const result = {{ structure.type_name }}Schema.safeParse(input);
  return result.success ? result.data : false;
}
{%- endif %}

{%- if structure.slices is defined and structure.slices | length > 0 %}

// Discriminated unions for sliced elements
{%- for slice in structure.slices %}
{%- if slice.discriminator %}
{%- set discriminator_field = slice.discriminator.path | split(pat=".") | last -%}
{%- else %}
{%- set discriminator_field = "value" -%}
{%- endif %}

/**
 * Discriminated union for {{ slice.path }}
 */
export type {{ slice.path | split(pat=".") | last | title }}Slice =
{%- for slice_info in slice.slices %}
{%- if slice_info.discriminator_value %}
  | { {{ discriminator_field }}: "{{ slice_info.discriminator_value }}"{% if slice_info.discriminator_type %}, value: {{ slice_info.discriminator_type }}{% endif %} }
{%- endif %}
{%- endfor %};

// Type guards for slices
{%- for slice_info in slice.slices %}
{%- if slice_info.discriminator_value %}
export function is{{ slice_info.name | title }}Slice(
  value: {{ slice.path | split(pat=".") | last | title }}Slice
): value is Extract<{{ slice.path | split(pat=".") | last | title }}Slice, { {{ discriminator_field }}: "{{ slice_info.discriminator_value }}" }> {
  return (value as any).{{ discriminator_field }} === "{{ slice_info.discriminator_value }}";
}
{%- endif %}
{% endfor %}
{%- endfor %}
{%- endif %}
