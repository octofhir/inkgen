  /** Reverse include */
  _revinclude?: {% if context.fhir_version == "R5" %}SearchParamValue<IncludeModifier, never> | Array<SearchParamValue<IncludeModifier, never>>{% else %}string | string[]{% endif %};
  /** Sort order */
